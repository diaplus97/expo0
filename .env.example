# 복사해서 .env 로 저장. 값이 비어 있으면 해당 기능은 개발 모드(fixture/mock/console)로 동작한다.
APP_NAME=지원사업 레이더
BASE_URL=https://your-domain.example            # 이메일 링크에 들어가는 도메인
SECRET_KEY=change-me
ADMIN_KEY=change-me-admin
DATABASE_URL=sqlite:///./radar.db               # Postgres: postgresql+psycopg://user:pw@host/db

# 수집 소스: fixture | bizinfo | kstartup (콤마로 여러 개)
INGEST_SOURCES=fixture
BIZINFO_API_KEY=
DATAGO_API_KEY=
KSTARTUP_API_URL=

# 채점: mock | anthropic
SCORER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
MAX_LLM_CANDIDATES_PER_USER=25
MIN_SCORE_TO_NOTIFY=55

# 이메일: console | resend | smtp
EMAIL_BACKEND=console
EMAIL_FROM=지원사업 레이더 <noreply@your-domain.example>
RESEND_API_KEY=

# 요금
FREE_MAX_ITEMS_PER_DIGEST=3
PRO_PRICE_KRW=9900
PAYMENT_LINK_URL=
